# デフォルト全除外
*

# 管理対象ファイル
!/.gitignore
!/CLAUDE.md
!/LICENSE
!/README.md
!/README.en.md
!/Taskfile.yml
!/build.ps1
!/redntfy.toml

# 管理対象ディレクトリ
!/.github/
!/.github/**
!/docs/
!/docs/**
!/src/
!/src/**
!/tests/
!/tests/**

# 管理対象内の除外
*.local.*
.env

# GitHub Pages（Jekyll）のローカルビルド成果物
/docs/_site/
/docs/.jekyll-cache/
/docs/.sass-cache/
